# Скопируйте в .env — docker compose подхватит автоматически
DS_KEY_RATE=0.14          # ключевая ставка ЦБ
SLA_HOURS=4               # срок рассмотрения заявки андеррайтером
SIGN_SALT=change-me       # соль кода подтверждения подписи
LLM_BASE_URL=             # OpenAI-совместимый API; пусто = без LLM
LLM_API_KEY=
LLM_MODEL=qwen3:4b
